# ==============================================================================
# ZentroMart AI Voice Assistant — Environment Configuration Template
# IIT Guwahati × Gnani.ai VoiceOps 2026 Capstone
# NOTE: Do NOT place real secrets in this file. Copy to .env and fill in values.
# ==============================================================================

# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gnani Voice Pipeline (Mandatory for STT and TTS in Step 4)
# Get your API key at: https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here

# Dataset & Knowledge Base Paths
DATASET_PATH=./Capstone_Project_Dataset_FTTT_2026
DATA_DIR=./Capstone_Project_Dataset_FTTT_2026/data
KB_DIR=./Capstone_Project_Dataset_FTTT_2026/kb
OUTPUT_DIR=./outputs

# Application Settings
LOG_LEVEL=INFO
PORT=8000
FRONTEND_PORT=5173
REFERENCE_DATE=2026-10-20
